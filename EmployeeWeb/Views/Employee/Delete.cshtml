@model EmployeeWeb.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<h2 class="text-danger">Delete Employee</h2>
<hr />

<div class="alert alert-warning">
    Are you sure you want to delete this employee?
</div>

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model!.FirstName @Model.LastName</dd>
    <dt class="col-sm-3">Position</dt>
    <dd class="col-sm-9">@Model.Position</dd>
    <dt class="col-sm-3">Salary</dt>
    <dd class="col-sm-9">$@Model.Salary.ToString("N2")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>